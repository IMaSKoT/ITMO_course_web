# скопируйте этот файл в .env и поменяйте значения под себя
# .env в git НЕ коммитится (он в .gitignore)

# --- база данных PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/dormitory
DB_NAME=dormitory
DB_USER=dormitory
DB_PASSWORD=dormitory

# --- JWT ---
# секрет для подписи токенов (HS256), минимум 32 символа
JWT_SECRET=change-me-please-this-is-a-very-long-secret-key
JWT_ISSUER=dormitory-app
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- администратор, который создаётся при первом запуске ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@itmo.ru
ADMIN_PASSWORD=Admin12345
