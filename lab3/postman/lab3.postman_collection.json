{
  "info": {"name": "Lab3 — основные проверки API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080/api"},
    {"key": "adminUsername", "value": "admin"},
    {"key": "adminPassword", "value": ""},
    {"key": "userUsername", "value": "student1"},
    {"key": "userEmail", "value": "student1@example.com"},
    {"key": "userPassword", "value": ""},
    {"key": "adminAccessToken", "value": ""},
    {"key": "adminRefreshToken", "value": ""},
    {"key": "userAccessToken", "value": ""},
    {"key": "usedRefreshToken", "value": ""}
  ],
  "item": [
    {
      "name": "1. Пользователи и токены",
      "item": [
        {
          "name": "Регистрация USER",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Создан или уже существует\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"]}}]
        },
        {
          "name": "Неверные данные регистрации",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"a\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"]}}]
        },
        {
          "name": "Вход ADMIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));", "const tokens = pm.response.json();", "pm.collectionVariables.set(\"adminAccessToken\", tokens.accessToken);", "pm.collectionVariables.set(\"adminRefreshToken\", tokens.refreshToken);"]}}]
        },
        {
          "name": "Вход USER",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}"},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));", "const tokens = pm.response.json();", "pm.collectionVariables.set(\"userAccessToken\", tokens.accessToken);"]}}]
        },
        {
          "name": "Обновление токенов ADMIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "body": {"mode": "raw", "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}"},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set(\"usedRefreshToken\", pm.collectionVariables.get(\"adminRefreshToken\"));"]}}, {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));", "const tokens = pm.response.json();", "pm.collectionVariables.set(\"adminAccessToken\", tokens.accessToken);", "pm.collectionVariables.set(\"adminRefreshToken\", tokens.refreshToken);"]}}]
        },
        {
          "name": "Старый refresh-токен: отказ",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "body": {"mode": "raw", "raw": "{\n  \"refreshToken\": \"{{usedRefreshToken}}\"\n}"},
            "header": [{"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"]}}]
        }
      ]
    },
    {
      "name": "2. Студенты (ADMIN)",
      "item": [
        {
          "name": "Неверные данные студента",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/requests",
            "body": {"mode": "raw", "raw": "{\n  \"fullName\": \"Тестов Тест\",\n  \"group\": \"P3210\",\n  \"isuId\": 42,\n  \"dormitory\": null,\n  \"room\": null,\n  \"settlementPeriod\": null,\n  \"isForeign\": false,\n  \"notes\": \"Проверка API\"\n}"},
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}, {"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"]}}]
        },
        {
          "name": "Некорректный JSON",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/requests",
            "body": {"mode": "raw", "raw": "{\"fullName\":"},
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}, {"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"]}}]
        },
        {
          "name": "Создать тестового студента",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/requests",
            "body": {"mode": "raw", "raw": "{\n  \"fullName\": \"Тестов Тест\",\n  \"group\": \"P3210\",\n  \"isuId\": 777777,\n  \"dormitory\": null,\n  \"room\": null,\n  \"settlementPeriod\": null,\n  \"isForeign\": false,\n  \"notes\": \"Проверка API\"\n}"},
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}, {"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"]}}]
        },
        {
          "name": "Повторный ИСУ: отказ",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/requests",
            "body": {"mode": "raw", "raw": "{\n  \"fullName\": \"Тестов Тест\",\n  \"group\": \"P3210\",\n  \"isuId\": 777777,\n  \"dormitory\": null,\n  \"room\": null,\n  \"settlementPeriod\": null,\n  \"isForeign\": false,\n  \"notes\": \"Проверка API\"\n}"},
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}, {"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"]}}]
        },
        {
          "name": "Поиск, сортировка и пагинация",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests?fullName=Тестов&group=P3210&sort=isuId&order=desc&page=1&size=5",
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "Фильтрация через QUERY",
          "request": {
            "method": "QUERY",
            "url": "{{baseUrl}}/requests",
            "body": {"mode": "raw", "raw": "{\n  \"group\": \"P3210\",\n  \"hasDormitory\": false\n}"},
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}, {"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "Получить тестового студента",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests/777777",
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "Полностью заменить данные",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/requests/777777",
            "body": {"mode": "raw", "raw": "{\n  \"fullName\": \"Тестов Тест\",\n  \"group\": \"P3210\",\n  \"isuId\": 777777,\n  \"dormitory\": null,\n  \"room\": null,\n  \"settlementPeriod\": null,\n  \"isForeign\": false,\n  \"notes\": \"Изменено через PUT\"\n}"},
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}, {"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "Изменить заметку",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/requests/777777",
            "body": {"mode": "raw", "raw": "{\n  \"notes\": \"Изменено через PATCH\"\n}"},
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}, {"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "Удалить тестового студента",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/requests/777777",
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"]}}]
        },
        {
          "name": "После удаления студент не найден",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests/777777",
            "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"]}}]
        }
      ]
    },
    {
      "name": "3. Проверка прав",
      "item": [
        {
          "name": "USER может читать",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests",
            "header": [{"key": "Authorization", "value": "Bearer {{userAccessToken}}"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "USER может получить одного студента",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests/111111",
            "header": [{"key": "Authorization", "value": "Bearer {{userAccessToken}}"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "USER не может добавлять",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/requests",
            "body": {"mode": "raw", "raw": "{\n  \"fullName\": \"Тестов Тест\",\n  \"group\": \"P3210\",\n  \"isuId\": 777777,\n  \"dormitory\": null,\n  \"room\": null,\n  \"settlementPeriod\": null,\n  \"isForeign\": false,\n  \"notes\": \"Проверка API\"\n}"},
            "header": [{"key": "Authorization", "value": "Bearer {{userAccessToken}}"}, {"key": "Content-Type", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"]}}]
        },
        {
          "name": "Без токена: отказ",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"]}}]
        }
      ]
    }
  ]
}
